{
    "name":  "mega-tools-client",
    "version":  "3.0.33",
    "type":  "module",
    "description":  "Mega Tools - Visitor Management System (Client - Local Only)",
    "author":  "Rokib Mahmud",
    "license":  "MIT",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "vite build",
                    "preview":  "vite preview",
                    "lint":  "eslint src --ext .js,.jsx",
                    "lint:fix":  "eslint src --ext .js,.jsx --fix",
                    "format":  "prettier --write src/**/*.{js,jsx,css}",
                    "format:check":  "prettier --check src/**/*.{js,jsx,css}",
                    "clean":  "node -e \"require(\u0027fs\u0027).rmSync(\u0027dist\u0027,{recursive:true,force:true})\"",
                    "verify":  "npm run lint \u0026\u0026 npm run format:check \u0026\u0026 npm run build"
                },
    "dependencies":  {
                         "axios":  "^1.7.0",
                         "date-fns":  "^3.6.0",
                         "lucide-react":  "^1.24.0",
                         "react":  "^18.3.1",
                         "react-dom":  "^18.3.1",
                         "react-router-dom":  "6.30.6",
                         "socket.io-client":  "^4.7.0"
                     },
    "devDependencies":  {
                            "@vitejs/plugin-react":  "^4.3.0",
                            "eslint":  "^8.57.0",
                            "eslint-plugin-react":  "^7.34.0",
                            "eslint-plugin-react-hooks":  "^4.6.0",
                            "prettier":  "^3.3.0",
                            "terser":  "^5.48.0",
                            "vite":  "^5.4.0"
                        }
}
